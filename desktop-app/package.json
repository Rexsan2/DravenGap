{
  "name": "dravengap",
  "version": "1.0.0",
  "description": "DravenGap: League of Legends draft, builds and profiles (a fork of DraftDiff by Lydig).",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-all.js",
    "dist": "electron-builder",
    "build:personal": "node tools/build-personal.js"
  },
  "author": "Lytten",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dravengap.app",
    "productName": "DravenGap",
    "files": [
      "**/*",
      "!tests${/*}",
      "!tools${/*}",
      "!.personal${/*}",
      "!dist${/*}"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon-dravengap.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
